{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speech Clip OSS",
  "version": "0.1.0",
  "identifier": "dev.speechclip.oss",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Speech Clip OSS",
        "width": 800,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true,
        "shadow": false,
        "hiddenTitle": true,
        "acceptFirstMouse": true
      },
      {
        "label": "dashboard",
        "title": "Speech Clip OSS",
        "url": "/dashboard",
        "width": 800,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "center": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "entitlements": null,
      "exceptionDomain": null,
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  }
}
